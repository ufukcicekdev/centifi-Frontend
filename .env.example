# Django API base URL — no trailing slash.
#
# Yerel geliştirme (simülatör / aynı makinede backend):
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# Üretim (Railway backend):
# EXPO_PUBLIC_API_BASE_URL=https://centifi-backend-production.up.railway.app
#
# Fiziksel telefon + yerel Django: LAN IP kullanın,
# örn. EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
# Django: python manage.py runserver 0.0.0.0:8000
#
# EAS/build: Üretim URL’sini Railway veya eas.json env olarak build öncesi verin;
# EXPO_PUBLIC_* bundle’a build zamanında gömülür.
