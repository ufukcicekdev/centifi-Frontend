## Android release signing (Upload key)
#
# Copy this file to `keystore.properties` (DO NOT commit that file).
# Then generate a keystore and fill values below.
#
# Example:
# storeFile=centifi-upload-key.jks
# storePassword=YOUR_STORE_PASSWORD
# keyAlias=centifi
# keyPassword=YOUR_KEY_PASSWORD

storeFile=
storePassword=
keyAlias=
keyPassword=

